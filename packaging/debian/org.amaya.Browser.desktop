[Desktop Entry]
Version=1.4
Type=Application
Name=Amaya
GenericName=Web Browser
Comment=Browse the web without being tracked
Exec=amaya %u
TryExec=amaya
Icon=org.amaya.Browser
Terminal=false
StartupNotify=true
StartupWMClass=amaya
Categories=Network;WebBrowser;
Keywords=Internet;WWW;Browser;Web;Explorer;Privacy;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/vnd.mozilla.xul+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=amaya --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=amaya --private-window %u
